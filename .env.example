# ====================================================================
# SHORTSMAKER WORKER - Environment Variables
# ====================================================================
# Copy this file to .env and fill in your actual values
#
# IMPORTANTE: Este worker conecta na infraestrutura da API
# Certifique-se de que a API esteja rodando com:
#   - PostgreSQL (porta 5432)
#   - MinIO (portas 9000/9001)
#   - WireMock (porta 8080) - opcional para mocks
#   - Network: shortsmaker-network
# ====================================================================

# ==================== DATABASE (PostgreSQL) ====================
# URL de conexão com o PostgreSQL (usa asyncpg driver)
# No Docker: postgres:5432
# No host: localhost:5432
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shortsmaker
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json ou text

# ==================== WORKER CONFIGURATION ====================
# Tempo em segundos entre polls no banco
WORKER_POLL_INTERVAL=5

# Número máximo de tentativas em caso de erro
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=10

# Timeout para graceful shutdown
WORKER_SHUTDOWN_TIMEOUT=30

# Número de workers concorrentes por tipo de tarefa
SCRIPT_WORKERS_COUNT=2
AUDIO_WORKERS_COUNT=2
VIDEO_WORKERS_COUNT=1
VTT_WORKERS_COUNT=2

# ==================== LLM SERVICES (TEXT GENERATION) ====================
# Provider para geração de texto/roteiro
# Opções: openai, gemini
LLM_TEXT_PROVIDER=gemini

# ------ OpenAI ------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=  # Deixe vazio para usar API oficial, ou http://wiremock:8080 para mocks
OPENAI_MODEL_TEXT=gpt-4o
OPENAI_TIMEOUT=60
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# ------ Google Gemini ------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_TEXT=gemini-2.0-flash-exp
GEMINI_TIMEOUT=60
GEMINI_MAX_TOKENS=4000
GEMINI_TEMPERATURE=0.7

# ==================== IMAGE GENERATION ====================
# Provider para geração de imagens
# Opções: openai, gemini, stability
IMAGE_PROVIDER=openai

# OpenAI DALL-E
OPENAI_MODEL_IMAGE=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

# Gemini Imagen
GEMINI_MODEL_IMAGE=imagen-3.0-generate-001

# Stability AI
STABILITY_API_KEY=sk-your-stability-api-key
STABILITY_MODEL=stable-diffusion-xl-1024-v1-0

# ==================== VIDEO GENERATION ====================
# Provider para geração de vídeo
# Opções: runway, gemini, stability
VIDEO_PROVIDER=runway

# ------ Runway ML ------
RUNWAY_API_KEY=your-runway-api-key
RUNWAY_BASE_URL=  # Deixe vazio para usar API oficial, ou http://wiremock:8080 para mocks
RUNWAY_MODEL=gen3a_turbo
RUNWAY_TIMEOUT=300
RUNWAY_DURATION=10

# ------ Gemini Veo ------
GEMINI_MODEL_VIDEO=veo-001

# ------ Stability AI Video ------
STABILITY_VIDEO_MODEL=stable-video-diffusion-img2vid-xt-1-1

# ==================== AUDIO/MUSIC ====================
# Provider para áudio/música
# Opções: placeholder, elevenlabs, openai
AUDIO_PROVIDER=placeholder

# ------ ElevenLabs TTS ------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL=eleven_multilingual_v2

# ------ OpenAI TTS ------
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ==================== STORAGE (MinIO / Supabase) ====================
# Provider de storage
# Opções: minio, supabase
STORAGE_PROVIDER=minio

# ------ MinIO (S3-compatible) ------
# No Docker: minio:9000
# No host: localhost:9010 (porta mapeada no docker-compose da API)
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shortsmaker
MINIO_SECURE=false  # true para HTTPS
MINIO_REGION=us-east-1

# ------ Supabase Storage ------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=shortsmaker

# ==================== FEATURE FLAGS ====================
ENABLE_CACHE=true
ENABLE_METRICS=false
ENABLE_TRACING=false
